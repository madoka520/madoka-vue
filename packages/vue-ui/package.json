  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^6.0.0",
    "less": "^4.3.0",
    "typescript": "~5.7.2",
    "unplugin-auto-import": "^0.17.5",
    "vite": "^6.3.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
