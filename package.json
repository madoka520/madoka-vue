{
  "name": "madoka-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:ui": "pnpm --filter @madoka520/vue-ui run build",
    "build:utils": "pnpm --filter @madoka520/vue-utils run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.5"
  }
}
